# =====================================================================
# Contoh konfigurasi backend. Salin menjadi .env lalu isi nilainya.
#   cp .env.example .env
# Jangan pernah commit file .env (sudah masuk .gitignore).
# =====================================================================

# ---------- Server ----------
PORT=3000

# ---------- Database MySQL ----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=presensi
DB_PASSWORD=ganti_dengan_password_database_yang_kuat
DB_NAME=absensi_lokal

# ---------- Login (JWT) ----------
# WAJIB minimal 32 karakter. Buat dengan: openssl rand -hex 32
JWT_SECRET=ganti_dengan_hasil_openssl_rand_hex_32
JWT_EXPIRES=12h

# ---------- Zona waktu sekolah ----------
# Asia/Jakarta (WIB) | Asia/Makassar (WITA) | Asia/Jayapura (WIT)
TZ_SEKOLAH=Asia/Jakarta

# ---------- Jam masuk (nilai awal) ----------
# Dipakai hanya jika menu Pengaturan Jam belum pernah disimpan.
JAM_MASUK_BATAS=07:30

# ---------- Presensi per mata pelajaran ----------
# Guru boleh mengisi/mengubah presensi mundur maksimal N hari.
PRESENSI_MAPEL_MAX_HARI_MUNDUR=7

# ---------- WhatsApp (Fonnte) ----------
# true = worker tetap jalan tetapi TIDAK mengirim pesan (aman untuk lokal).
WA_PAUSED=true
# Hanya nilai "false" yang mematikan pesan "siswa belum scan".
WA_TIDAK_SCAN=true
WA_JAM_TIDAK_SCAN=08:30
# 0=Minggu ... 6=Sabtu
WA_HARI_AKTIF=1,2,3,4,5,6
# Jika persentase siswa hadir di bawah angka ini, dianggap libur/alat rusak.
WA_MIN_HADIR_PERSEN=20

# Batas pengiriman per nomor pengirim (wali kelas).
WA_MAX_ATTEMPTS=5
WA_MAX_PER_HOUR=60
WA_MAX_PER_DAY=150

# Jeda antar pesan (milidetik) dan istirahat per batch.
WA_DELAY_MIN_MS=25000
WA_DELAY_MAX_MS=50000
WA_BATCH_MIN=12
WA_BATCH_MAX=20
WA_REST_MIN_MS=180000
WA_REST_MAX_MS=360000

# Jeda otomatis saat nomor bermasalah (mis. token/perangkat terputus).
WA_PAUSE_MS=3600000
WA_PAUSE_MAX_MS=28800000

# Umur maksimal pesan di antrean sebelum kedaluwarsa (jam).
WA_MAX_AGE_HOURS=12
WA_MAX_AGE_MASUK_HOURS=6
