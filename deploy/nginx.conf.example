# Contoh konfigurasi Nginx untuk App Presensi (Ubuntu 24.04).
#
# Kondisi saat ini di VPS:
#   domain      : absen.mts-musidomulyo.cloud
#   frontend    : /var/www/frontend
#   backend     : /var/www/backend (port 3000, PM2)
#
# File ini hanya contoh. JANGAN langsung menimpa konfigurasi yang sudah jalan.
# Bandingkan dulu dengan:
#   sudo nginx -T | less
#   ls /etc/nginx/sites-enabled/
#
# Setelah yakin, salin ke /etc/nginx/sites-available/presensi lalu:
#   sudo ln -s /etc/nginx/sites-available/presensi /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx
#
# HTTPS sudah aktif (Let's Encrypt). Certbot akan menambahkan blok 443 sendiri.

server {
    listen 80;
    listen [::]:80;
    server_name absen.mts-musidomulyo.cloud;

    # Hasil `npm run build` disalin ke /var/www/frontend.
    root /var/www/frontend;
    index index.html;

    # Samakan dengan batas JSON di backend (import Excel).
    client_max_body_size 2m;

    # ---------- API backend ----------
    location /api/ {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    # ---------- Socket.io (notifikasi scan realtime) ----------
    location /socket.io/ {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    # ---------- File statis hasil build (nama file ber-hash) ----------
    location /assets/ {
        expires 30d;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # index.html jangan di-cache agar update langsung terlihat.
    location = /index.html {
        add_header Cache-Control "no-store";
    }

    # ---------- SPA React ----------
    location / {
        try_files $uri $uri/ /index.html;
    }
}
